# Porta da aplicação
PORT=3333

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=agenda_inteligente
DATABASE_URL=postgresql://postgres:troque_por_uma_senha_forte@postgres:5432/agenda_inteligente?schema=public

# Autenticação JWT
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria
JWT_EXPIRES_IN=30d

# Credenciais da conta administradora
ADMIN_LOGIN=keidson.rodrigues
ADMIN_PASSWORD=troque_por_uma_senha_forte
ADMIN_NAME=Pr. Keidson Rodrigues

# CORS
CORS_ORIGIN=*

# Opcional: Google Gemini
GEMINI_API_KEY=
