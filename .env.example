# ==============================================================================
# Agenda Inteligente - Configurações de Ambiente (Railway / Coolify / Docker)
# Copie este arquivo para .env ao rodar localmente com docker-compose
# No Railway ou Coolify, defina essas variáveis no painel "Variables / Environment"
# ==============================================================================

# Porta da aplicação
PORT=3333

# PostgreSQL Database (No Railway, crie um serviço PostgreSQL e use a DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_super_senha_segura
POSTGRES_DB=agenda_inteligente
DATABASE_URL=postgresql://postgres:postgres_super_senha_segura@postgres:5432/agenda_inteligente?schema=public

# Autenticação JWT
JWT_SECRET=chave_secreta_jwt_longa_e_aleatoria_para_producao_2026
JWT_EXPIRES_IN=30d

# Credenciais de Acesso (Configure aqui seu e-mail e senha)
ADMIN_EMAIL=pastor@agendainteligente.com
ADMIN_PASSWORD=sua_senha_segura_aqui
ADMIN_NAME=Pr. Keidson Rodrigues

# CORS (permitir todas as origens ou o domínio de deploy)
CORS_ORIGIN=*

# (Opcional) Chave de API Google Gemini
GEMINI_API_KEY=
