# ==============================================================================
# Agenda Inteligente - Backend (.env.example)
# Copie este arquivo para .env e preencha com seus valores reais
# Para produção (Railway / Coolify), configure estas variáveis de ambiente no painel
# ==============================================================================

# Porta da API HTTP
PORT=3333

# URL de Conexão com o Banco de Dados PostgreSQL (Prisma ORM)
# Local: postgresql://postgres:postgres@localhost:5432/agenda_inteligente?schema=public
# Railway: Utilize a variável DATABASE_URL injetada pelo plugin do PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agenda_inteligente?schema=public"

# Chave secreta para assinatura dos tokens JWT (use uma string segura em produção)
JWT_SECRET="agenda-inteligente-jwt-secret-key-super-segura-2026"

# Tempo de expiração do token de sessão JWT
JWT_EXPIRES_IN="30d"

# Origens autorizadas no CORS (ex.: * ou o domínio do frontend na VPS/Railway)
CORS_ORIGIN="*"

# (Opcional) Chave da API do Google Gemini para recursos expandidos do Assistente de IA
GEMINI_API_KEY=""
