generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("owner") // owner, admin, user
  theme        String   @default("dark") // dark, light, system
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings      UserSettings?
  activities    Activity[]
  travels       Travel[]
  people        Person[]
  notifications Notification[]
  files         FileAsset[]
  auditLogs     AuditLog[]
}

model UserSettings {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        String   @default("confirm")
  workStart   String   @default("08:00")
  workEnd     String   @default("18:00")
  workDays    Json     @default("[1,2,3,4,5]")
  categories  Json
  specialCats Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model Activity {
  id               String  @id
  userId           String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  date             String // YYYY-MM-DD
  start            String // HH:MM
  end              String // HH:MM
  status           String  @default("planejada") // planejada, concluida, pendente, cancelada, reagendada
  category         String
  priority         String  @default("media") // alta, media, baixa
  recur            Json // { freq, days, until, dates }
  reminder         Int     @default(30)
  fixed            Boolean @default(false)
  deadline         String  @default("")
  autoResched      Boolean @default(true)
  kept             Boolean @default(false)
  span             Boolean @default(false)
  notes            String  @default("")
  subtasks         Json    @default("[]")
  links            Json    @default("[]")
  files            Json    @default("[]")
  history          Json    @default("[]")
  overrides        Json    @default("{}")
  origin           Json?
  rescheduledCount Int     @default(0)
  createdAt        BigInt
  updatedAt        BigInt

  @@index([userId, date])
}

model Travel {
  id        String @id
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  date      String // YYYY-MM-DD
  start     String // HH:MM
  endDate   String // YYYY-MM-DD
  end       String // HH:MM
  notes     String @default("")
  updatedAt BigInt

  @@index([userId, date])
}

model Person {
  id        String @id
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // aniversario | profissional
  name      String
  day       Int
  month     Int
  whatsapp  String @default("")
  role      String @default("")
  createdAt BigInt

  @@index([userId, type])
}

model Notification {
  id     String  @id
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  at     BigInt
  title  String
  body   String
  type   String
  read   Boolean @default(false)

  @@index([userId, at])
}

model FileAsset {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  mimeType   String
  size       Int
  dataBase64 String   @db.Text
  createdAt  DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
